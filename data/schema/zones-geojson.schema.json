{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zone boundaries (data/zones.geojson)",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "properties", "geometry"],
        "properties": {
          "type": { "const": "Feature" },
          "properties": { "type": "object", "required": ["zone"], "properties": { "zone": { "type": "string", "pattern": "^\\d{2}$" } } },
          "geometry": { "type": "object", "properties": { "type": { "enum": ["Polygon", "MultiPolygon"] } } }
        }
      }
    }
  }
}
