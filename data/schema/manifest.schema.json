{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prayer-time data manifest",
  "type": "object",
  "required": ["contract", "revision", "revised", "source", "files"],
  "properties": {
    "contract": { "const": 1 },
    "revision": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$" },
    "revised": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": {
      "type": "object",
      "required": ["name", "url", "edition"],
      "properties": { "name": { "type": "string" }, "url": { "type": "string" }, "edition": { "type": "string" } }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
